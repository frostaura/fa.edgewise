# ============================================================================
# Edgewise environment — copy to .env (or paste into Portainer's stack env UI)
# and fill in real values. Required unless marked optional.
# ============================================================================

# ----------------------------------------------------------------------------
# Images (optional)
# ----------------------------------------------------------------------------
# Docker Hub namespace the edgewise-api/edgewise-web images are published under.
#DOCKERHUB_USERNAME=frostaura

# Image tag to deploy: "latest" or a git commit SHA for pinned deploys.
#EDGEWISE_TAG=latest

# Host port the web UI (and proxied API) is exposed on.
#EDGEWISE_PORT=8080

# Container timezone (affects daily jobs / calendar boundaries).
#TZ=Africa/Johannesburg

# ----------------------------------------------------------------------------
# Database (REQUIRED)
# ----------------------------------------------------------------------------
# Password for the bundled Postgres and the API connection string.
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------------
# Secrets (REQUIRED)
# ----------------------------------------------------------------------------
# Signing secret for auth tokens (JWT). Long random string.
# Generate: openssl rand -base64 48
EDGEWISE_JWT_SECRET=

# AES key for encrypting sensitive fields at rest. MUST be exactly 32 bytes,
# base64-encoded.
# Generate: openssl rand -base64 32
EDGEWISE_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# AI Coach (optional — Coach LLM features degrade to deterministic analytics
# without a key)
# ----------------------------------------------------------------------------
# OpenRouter is the provider of choice (https://openrouter.ai/keys).
#OPENROUTER_API_KEY=
# Fallback: a direct Anthropic API key is also supported when no OpenRouter
# key is configured (https://console.anthropic.com/).
#ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Web push notifications (optional — push alerts disabled without them)
# ----------------------------------------------------------------------------
# VAPID key pair + contact subject for Web Push.
# Generate a pair: npx web-push generate-vapid-keys
#EDGEWISE_VAPID_PUBLIC_KEY=
#EDGEWISE_VAPID_PRIVATE_KEY=
#EDGEWISE_VAPID_SUBJECT=mailto:you@example.com

# ----------------------------------------------------------------------------
# SMTP email (optional — email notifications disabled without it)
# ----------------------------------------------------------------------------
# GoDaddy custom-domain mailboxes (Workspace Email) use:
#   SMTP_HOST=smtpout.secureserver.net  SMTP_PORT=587 (STARTTLS) or 465 (SSL)
#   SMTP_USER=you@yourdomain.com        SMTP_PASSWORD=<mailbox password>
# GoDaddy Microsoft 365 mailboxes instead use smtp.office365.com:587.
#SMTP_HOST=smtpout.secureserver.net
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=edgewise@yourdomain.com
